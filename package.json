{
  "name": "pi-weixin-bridge",
  "version": "1.0.0",
  "description": "微信 ClawBot ↔ pi 桥接服务（iLink 协议直连，pi SDK 同进程接入）",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc",
    "serve": "node dist/index.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop pi-weixin-bridge",
    "pm2:restart": "pm2 restart pi-weixin-bridge",
    "pm2:logs": "pm2 logs pi-weixin-bridge",
    "pm2:save": "pm2 save"
  },
  "keywords": [
    "weixin",
    "wechat",
    "clawbot",
    "ilink",
    "pi",
    "agent",
    "bridge"
  ],
  "license": "MIT",
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.82.0",
    "qrcode-terminal": "0.12.0",
    "typebox": "^1.1.38"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "pm2": "^7.0.3",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=18"
  }
}
