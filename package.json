{
  "name": "pi-weixin-bridge",
  "version": "1.7.1",
  "description": "微信 ClawBot ↔ pi 桥接服务（iLink 协议直连）| Bridge service connecting the pi coding agent to WeChat ClawBot via the iLink protocol",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "src/index.ts",
  "bin": {
    "pi-weixin-bridge": "./bin/pi-weixin-bridge.js"
  },
  "files": [
    "bin",
    "src",
    "scripts/*.mjs",
    "scripts/windows-helper.js",
    "README.md",
    "README_en.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "postinstall": "node scripts/check-native.mjs",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "serve": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "weixin",
    "wechat",
    "wechat-bot",
    "wechat-bridge",
    "clawbot",
    "ilink",
    "pi",
    "agent",
    "ai-agent",
    "coding-agent",
    "chatbot",
    "bridge",
    "typescript",
    "nodejs"
  ],
  "license": "MIT",
  "author": "ReachForStar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ReachForStar/pi-weixin-bridge.git"
  },
  "homepage": "https://github.com/ReachForStar/pi-weixin-bridge#readme",
  "bugs": {
    "url": "https://github.com/ReachForStar/pi-weixin-bridge/issues"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.82.0",
    "@firecrawl/anydoc": "0.2.4",
    "cron-parser": "5.10.1",
    "minisearch": "7.2.0",
    "qrcode-terminal": "0.12.0",
    "tsx": "^4.19.0",
    "typebox": "^1.1.38"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "^5.8.0",
    "vitest": "^3.2.7"
  },
  "optionalDependencies": {
    "winax": "3.6.8"
  }
}
